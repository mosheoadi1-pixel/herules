DATABASE_URL=postgresql://postgres:local-dev-only@127.0.0.1:55432/postgres
APP_ORIGIN=http://localhost:3000
# Canonical address; additional same-origin IP/domain aliases are accepted automatically.
PORT=3000
# Production: NODE_ENV=production, HTTPS APP_ORIGIN and a private, backed-up PostgreSQL database.
# Environment variables are read from the process; .env is not automatically loaded.
# Optional: TRUST_PROXY=loopback (only if the server is reachable solely through that local proxy).
# Optional: HR_MODE=private (default) or public; any other value stops startup.
# Public mode only. Verification media is stored locally until its retention window ends (default .local/verification).
# Optional: HR_VERIFICATION_DIR=<absolute or relative path>; default .local/verification.
# Optional: HR_VERIFICATION_RETENTION_DAYS=7 (integer 1-365; deletes media this many days after a decision).
# Optional: HR_ADMIN_PUBLIC_IDS=<public user id>[,<id>...] lists the only reviewers allowed to decide manual reviews.
# Required to enable Google sign-in in public mode; both must be set, otherwise Google is not offered.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
