DATABASE_URL=postgresql://postgres:local-dev-only@127.0.0.1:55432/postgres
APP_ORIGIN=http://localhost:3000
# Canonical address; additional same-origin IP/domain aliases are accepted automatically.
PORT=3000
# Production: NODE_ENV=production, HTTPS APP_ORIGIN and a private, backed-up PostgreSQL database.
# Environment variables are read from the process; .env is not automatically loaded.
# Optional: TRUST_PROXY=loopback (only if the server is reachable solely through that local proxy).
