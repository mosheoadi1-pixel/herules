{
  "name": "her-rules",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx tests/library.ts && tsx tests/guidance.ts && tsx tests/notifications.ts && tsx tests/integration.ts && tsx tests/private-game-migration.ts && tsx tests/ideas-import.ts && tsx tests/startup-reset.ts && tsx tests/experience.ts && tsx tests/play-flow.ts",
    "import:ideas": "tsx scripts/import-ideas.ts",
    "test:browser": "tsx tests/browser.ts",
    "test:production": "tsx tests/production.ts",
    "db:start": "node scripts/db/start.mjs",
    "db:test": "node scripts/db/test.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
